# === IA ===
# DeepSeek é a primeira opção; Gemini fica como fallback.
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === PIPELINE EDITORIAL ===
AI_PIPELINE_MODE=three-provider
AI_CACHE_ENABLED=true
AI_DEEPSEEK_SCORE_THRESHOLD=90
AI_MONTHLY_BUDGET_USD=1.60
AI_BUDGET_RESERVE_USD=0.40
DEEPSEEK_INPUT_USD_PER_MILLION=0.27
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.10
AUTO_CREATE_PR=false

# === AUTOMAÇÃO EDITORIAL ===
# Mantenha false até configurar os secrets e cadastrar pautas com pesquisa concluída.
AUTOMATION_ENABLED=false
AUTOMATION_DRY_RUN=true
AUTOMATION_QUEUE_PATH=bot/automation-queue.json

# === GITHUB ===
GITHUB_TOKEN=seu_github_token
GITHUB_MODELS_MODEL=gpt-4o-mini
GITHUB_USER=seu_usuario
GITHUB_REPO=thebikerblog
GITHUB_BRANCH=main

# === BLOG ===
BLOG_TITLE="TheBiker Blog"
BLOG_URL=https://seu_usuario.github.io/thebikerblog
AUTHOR_NAME="Equipe TheBiker"

# === SEGURANÇA ===
# Integração isolada e indisponível até revisão de segurança das dependências.
WHATSAPP_ENABLED=false
# Números do WhatsApp autorizados (formato: DDI+DDD+número, separados por vírgula)
# Deixe vazio para aceitar qualquer número (não recomendado em produção)
AUTHORIZED_WHATSAPP_NUMBERS=
# Limite diário de solicitações por número
DAILY_REQUEST_LIMIT=10

# === SERVIDOR ===
PORT=3000
